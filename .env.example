# Port for Express API server (default: 3001)
PORT=3001

# AI Provider Configuration
# Set AI_API_KEY to your Gemini or OpenAI API key.
# If left empty, StudyFlow runs in high-fidelity intelligent Mock Mode
# with comprehensive simulation for development and offline testing.
AI_API_KEY=

# Provider selection: 'gemini' | 'openai' | 'mock' (default: 'gemini' if AI_API_KEY is set, else 'mock')
AI_PROVIDER=gemini

# Specific Model Override (optional)
# Gemini default: gemini-1.5-flash or gemini-2.0-flash
# OpenAI default: gpt-4o-mini
AI_MODEL=gemini-1.5-flash
